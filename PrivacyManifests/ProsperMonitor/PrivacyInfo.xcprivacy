<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Prosper has no backend, no accounts, no analytics and no third-party
	     SDKs. Nothing is collected, nothing is transmitted, nothing is used for
	     tracking. Screen Time data is read only inside the DeviceActivityReport
	     extension and never leaves the device. -->
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>
	<key>NSPrivacyCollectedDataTypes</key>
	<array/>
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<dict>
			<!-- UserDefaults(suiteName: "group.com.mostafa.prosper"): the active
			     block snapshot, the pending intervention flag, the classification
			     snapshot and the store-health flag are shared between the app and
			     its own extensions. This target touches UserDefaults only through
			     that App Group suite, never UserDefaults.standard, so the reason
			     is 1C8F.1 (App Group–shared defaults). CA92.1 is for defaults
			     only the app itself can read, which is not what this is (QA-9). -->
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>1C8F.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
