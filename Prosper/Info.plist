<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Merged into the generated Info.plist. Xcode has no INFOPLIST_KEY_ build
	     setting for the launch colour, so it has to be spelled out here. -->
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
	</dict>
	<!-- Connected devices (M7.3): iOS wakes the app now and then to send this
	     iPhone's day to the user's Mac and fetch the Mac's. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>fetch</string>
	</array>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>com.mostafa.prosper.sync</string>
	</array>
</dict>
</plist>
